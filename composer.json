{
    "name": "git/git-bundle",
    "type": "symfony-bundle",
    "description": "GitHub-like git repository viewer for Symfony, powered by libgit2 via the php-git2 extension",
    "homepage": "https://www.glitchr.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Git\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Git\\": "./tests"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-git2": "*",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/routing": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    }
}
