{% set ref_default = ref ?? config.default_branch %}
<div class="repo-header">
    <h1>
        <a href="{{ path('git_repositories') }}">Repositories</a>
        <span style="color:#57606a">/</span>
        <a href="{{ path('git_repo_default', {repo: repo}) }}">{{ config.label ?? repo }}</a>
    </h1>
    {% if config.description %}
        <p class="repo-desc">{{ config.description }}</p>
    {% endif %}
</div>

<nav class="tab-nav">
    <a href="{{ path('git_tree', {repo: repo, ref: ref_default, path: ''}) }}"
       class="{{ app.request.attributes.get('_route') == 'git_tree' ? 'active' : '' }}">
        &#x1F4C1; Files
    </a>
    <a href="{{ path('git_log', {repo: repo, ref: ref_default}) }}"
       class="{{ app.request.attributes.get('_route') == 'git_log' ? 'active' : '' }}">
        &#x23F3; Commits
    </a>
    <a href="{{ path('git_graph_page', {repo: repo}) }}"
       class="{{ app.request.attributes.get('_route') == 'git_graph_page' ? 'active' : '' }}">
        &#x1F500; Graph
    </a>
    <a href="{{ path('git_branches', {repo: repo}) }}"
       class="{{ app.request.attributes.get('_route') in ['git_branches', 'git_tags'] ? 'active' : '' }}">
        &#x1F33F; Refs
    </a>
</nav>
